# =============================================================
# Tractor Repair Marketplace - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit real secrets to version control
# =============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-side only, NEVER in mobile/browser
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Supabase Auth (Phone/OTP) ---
# Configure phone auth provider in Supabase Dashboard > Authentication > Providers
# Supported SMS providers: Twilio, MessageBird, Vonage, MSG91
# See: https://supabase.com/docs/guides/auth/phone-login

# --- Domestic SMS & WhatsApp Dispatch (send-sms-alert Edge Function) ---
# Fast2SMS (Indian domestic 10-digit mobile SMS via Quick Transactional API)
FAST2SMS_API_KEY=your-fast2sms-api-key
# Twilio WhatsApp Business API (E.164 phone numbers)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Razorpay (Server-side only) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Expo Push Notifications ---
EXPO_ACCESS_TOKEN=your-expo-access-token

# --- Admin Dashboard ---
NEXTAUTH_SECRET=generate-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# --- App Configuration (defaults, override in app_settings table) ---
DEFAULT_COMMISSION_RATE=10.00
DEFAULT_VISIT_CHARGE=200.00
DEFAULT_SERVICE_RADIUS_KM=25
DEFAULT_ASSIGNMENT_TIMEOUT_SECONDS=30
